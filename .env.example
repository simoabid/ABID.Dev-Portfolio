# =============================================================================
# ABID.Dev Portfolio — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# All variables are OPTIONAL — the app runs without them in mock/console mode.

# ─── Mail Provider ───────────────────────────────────────────────────────────
# Which email service to use: 'resend' | 'sendgrid' | 'console' (default)
MAIL_PROVIDER=console

# Resend (https://resend.com — free tier: 3000 emails/month)
RESEND_API_KEY=
RESEND_FROM_EMAIL=Portfolio <onboarding@resend.dev>

# SendGrid (https://sendgrid.com — free tier: 100 emails/day)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# Where to receive contact form submissions
CONTACT_EMAIL=seemooabid@gmail.com

# ─── Captcha (Optional) ─────────────────────────────────────────────────────
# Provider: 'recaptcha' | 'hcaptcha' | leave empty to disable
# When empty, captcha verification is skipped entirely.

# Google reCAPTCHA v3 (https://www.google.com/recaptcha/admin)
NEXT_PUBLIC_CAPTCHA_PROVIDER=
NEXT_PUBLIC_CAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# hCaptcha (https://dashboard.hcaptcha.com)
# Set NEXT_PUBLIC_CAPTCHA_PROVIDER=hcaptcha and fill these instead:
HCAPTCHA_SECRET_KEY=

# ─── Site Configuration ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://abid.dev
